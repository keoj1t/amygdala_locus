# 1. Serper.dev API (Живой поиск изображений в Google Images через Serper API)
SERPER_API_KEY=your_serper_key_here

# 2. Google Custom Search (Опционально)
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_google_cx_here

# 3. Google Gemini API Key (Vision-верификация и расчет Trust Score)
GEMINI_API_KEY=your_gemini_key_here

# 4. OpenAI API Key (Опциональный Vision-фоллбек на GPT-4o-mini)
OPENAI_API_KEY=your_openai_key_here

# 5. Groq API Key (AI-сапмари кампуса)
GROQ_API_KEY=your_groq_key_here
